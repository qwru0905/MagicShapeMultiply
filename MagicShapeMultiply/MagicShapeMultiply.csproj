<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <LangVersion>11.0</LangVersion>
	  <TargetFramework>net48</TargetFramework>
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	  <ApplicationIcon />
	  <Win32Resource />
	  <!-- 게임이 설치된 Managed 폴더 경로. 본인 환경에 맞게 MagicShapeMultiply.csproj.user 파일에서 재정의하세요. -->
	  <AdofaiManagedDir Condition="'$(AdofaiManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice\A Dance of Fire and Ice_Data\Managed</AdofaiManagedDir>
	  <!-- EditorTabLib.dll, Localizations.dll 빌드 결과물이 위치한 경로. 본인 환경에 맞게 MagicShapeMultiply.csproj.user 파일에서 재정의하세요. -->
	  <EditorTabLibDir Condition="'$(EditorTabLibDir)' == ''">..\..\04_EditorTabLib\EditorTabLib\bin\Debug\net4.8</EditorTabLibDir>
	  <LocalizationsDir Condition="'$(LocalizationsDir)' == ''">..\..\06_Localizations\bin\Debug\net4.8</LocalizationsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(AdofaiManagedDir)\UnityModManager\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AdofaiManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(AdofaiManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(AdofaiManagedDir)\DOTween.dll</HintPath>
    </Reference>
    <Reference Include="EditorTabLib">
      <HintPath>$(EditorTabLibDir)\EditorTabLib.dll</HintPath>
    </Reference>
    <Reference Include="Localizations">
      <HintPath>$(LocalizationsDir)\Localizations.dll</HintPath>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(AdofaiManagedDir)\netstandard.dll</HintPath>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(AdofaiManagedDir)\RDTools.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(AdofaiManagedDir)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.InputModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(AdofaiManagedDir)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(AdofaiManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 빌드 후 게임의 Mods\MagicShapeMultiply 폴더로 DLL을 자동 복사합니다. AdofaiModsDir을 csproj.user에서 지정하지 않으면 AdofaiManagedDir 기준으로 자동 추정합니다. -->
  <Target Name="DeployToMods" AfterTargets="Build">
    <PropertyGroup>
      <_ModsDir Condition="'$(AdofaiModsDir)' != ''">$(AdofaiModsDir)</_ModsDir>
      <_ModsDir Condition="'$(_ModsDir)' == ''">$(AdofaiManagedDir)\..\..\Mods</_ModsDir>
    </PropertyGroup>
    <MakeDir Directories="$(_ModsDir)\MagicShapeMultiply" Condition="Exists('$(_ModsDir)') and !Exists('$(_ModsDir)\MagicShapeMultiply')" />
    <Copy SourceFiles="Info.json" DestinationFolder="$(_ModsDir)\MagicShapeMultiply" Condition="Exists('$(_ModsDir)') and !Exists('$(_ModsDir)\MagicShapeMultiply\Info.json')" />
    <Copy SourceFiles="icon_multiply.png;icon_create.png;default.png" DestinationFolder="$(_ModsDir)\MagicShapeMultiply" Condition="Exists('$(_ModsDir)') and !Exists('$(_ModsDir)\MagicShapeMultiply\icon_multiply.png')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_ModsDir)\MagicShapeMultiply" Condition="Exists('$(_ModsDir)')" />
  </Target>

</Project>
